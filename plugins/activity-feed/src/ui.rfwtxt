import fluxdo;

widget Card = Statistics(items: data.stats);
widget Feed = AdaptivePane(
  compactHeader: switch data.hasUsers {true: Padding(padding: [12.0, 4.0, 12.0, 0.0], child: PeopleStrip()), default: SizedBoxShrink()},
  sidebar: ListPage(header: Label(text: "我的订阅", style: "titleMedium"), items: [
    ...for p in data.people: ListItem(title: p.label, leading: Avatar(label: p.name, url: p.avatar, count: p.count), trailing: switch p.selected {true: Symbol(name: "check", color: "primary"), default: SizedBoxShrink()}, onTap: event "select" {who: p.name})
  ]),
  body: ListPage(empty: FeedEmpty(), loading: data.manual, hasMore: data.more, loadingMore: data.historyLoading, onLoadMore: event "more" {}, onRefresh: event "refresh" {},
    header: Column(crossAxisAlignment: "stretch", children: [
      Row(children: [Expanded(child: Label(text: data.title, style: "labelLarge", color: "onSurfaceVariant")), IconButton(icon: "group", tooltip: "从关注中选择", onPressed: event "import" {}), IconButton(icon: "add", tooltip: "添加订阅", onPressed: event "new" {}), IconButton(icon: "settings", tooltip: "订阅管理", onPressed: event "manage" {})]),
      switch data.hasUsers {true: Row(children: [
        Expanded(child: SingleChildScrollView(scrollDirection: "horizontal", primary: false, child: Row(children: [
          Choice(label: "未读", selected: data.unreadOnly, onSelected: event "unread" {}), Gap(size: 8),
          ...for t in data.types: Padding(padding: [0.0,0.0,6.0,0.0], child: Choice(label: t.label, selected: t.selected, onSelected: event "select" {kind: t.id}))
        ]))),
        switch data.hasUnread {true: IconButton(icon: "check_circle", tooltip: "全部标为已读", onPressed: event "read" {}), default: SizedBoxShrink()}
      ]), default: SizedBoxShrink()},
      switch data.needsActivity {true: ListItem(title: "动态读取权限未开启", subtitle: "仍可查看已保存的动态", trailing: Button(label: "允许更新", variant: "tonal", onPressed: event "refresh" {})), default: SizedBoxShrink()},
      Notice()
    ]),
    items: [...for r in data.items: ContentRow(title: r.title, summary: r.summary, meta: r.meta, leading: GestureDetector(child: Avatar(label: r.name, url: r.avatar), onTap: event "profile" {name: r.name}), detail: RelativeTime(value: r.time), onTap: event "topic" {topic: r.topic, post: r.post, owner: r.owner, id: r.id})]
  )
);
widget PeopleStrip = SingleChildScrollView(scrollDirection: "horizontal", primary: false, child: Row(children: [...for p in data.people: Padding(padding: [0.0,0.0,4.0,0.0], child: Choice(label: p.label, layout: "stacked", leading: Avatar(label: p.name, url: p.avatar, size: 34, count: p.count), selected: p.selected, onSelected: event "select" {who: p.name}))]));
widget FeedEmpty = switch data.hasUsers {
  true: EmptyState(title: data.empty, icon: "history", action: switch data.filtered {true: Button(label: "清除筛选", variant: "text", onPressed: event "reset" {}), default: Button(label: "更新动态", variant: "text", onPressed: event "refresh" {})}),
  default: EmptyState(title: "订阅第一位用户", message: "关注的用户有新动态时，会出现在这里。", icon: "group", action: Wrap(alignment: "center", spacing: 8.0, children: [Button(label: "添加用户", icon: "add", onPressed: event "new" {}), Button(label: "从关注中选择", variant: "tonal", onPressed: event "import" {})]))
};
widget Notice = Column(crossAxisAlignment: "stretch", children: [
  switch data.olderWindow {true: Button(label: "返回最近动态", variant: "text", onPressed: event "reset" {}), default: SizedBoxShrink()},
  switch data.historyWindowEnd {true: Button(label: "继续浏览较早动态", variant: "tonal", onPressed: event "historyNext" {}), default: SizedBoxShrink()},
  switch data.progress {"": SizedBoxShrink(), default: Label(text: data.progress, style: "bodySmall", color: "onSurfaceVariant")},
  switch data.error {"": SizedBoxShrink(), default: Label(text: data.error, color: "error")},
  switch data.historyError {"": SizedBoxShrink(), default: ListItem(title: data.historyError, trailing: Button(label: "重试", variant: "text", onPressed: event "more" {}))},
  switch data.scheduleError {"": SizedBoxShrink(), default: Label(text: data.scheduleError, color: "onSurfaceVariant")}
]);
widget Settings = ListPage(header: Column(crossAxisAlignment: "stretch", children: [
    Wrap(spacing: 8.0, children: [Button(label: "添加用户", icon: "add", onPressed: event "new" {}), Button(label: "从关注中选择", variant: "tonal", onPressed: event "import" {}), Button(label: "导入名单", variant: "tonal", onPressed: event "bulk" {})]),
    Gap(size: 16), Notice(), Surface(child: Column(children: [
      ListItem(title: "自动更新", subtitle: "按批次检查名单，受限时从上次位置继续", trailing: Toggle(value: data.enabled, onChanged: event "schedule" {mode: "enable"})),
      switch data.enabled {true: Wrap(spacing: 6.0, children: [...for p in data.pace: Choice(label: p.label, selected: p.selected, onSelected: event "schedule" {pace: p.n})]), default: SizedBoxShrink()},
      ListItem(title: "后台刷新", subtitle: "由系统安排更新", trailing: Toggle(value: data.background, onChanged: event "schedule" {mode: "background"})),
      ListItem(title: "新动态通知", trailing: Toggle(value: data.notify, onChanged: event "notify" {})),
      switch data.notificationBlocked {true: Padding(padding: [16.0, 12.0, 16.0, 12.0], child: Column(crossAxisAlignment: "stretch", children: [Label(text: "系统通知已关闭", style: "titleSmall"), Gap(size: 4), Label(text: "订阅仍会更新，开启系统通知后才能收到提醒", color: "onSurfaceVariant"), Gap(size: 8), switch data.notificationSettings {true: Button(label: "系统设置", variant: "tonal", onPressed: event "notificationSettings" {}), default: SizedBoxShrink()}])), default: SizedBoxShrink()},
      switch data.notificationUnknown {true: Label(text: "系统未提供通知状态，请在系统设置中确认 FluxDO 通知已开启。", style: "bodySmall", color: "onSurfaceVariant"), default: SizedBoxShrink()}
    ])), Gap(size: 16), Label(text: "我的订阅", style: "titleSmall")]),
    emptyTitle: "还没有订阅", items: [...for u in data.users: ListItem(title: u.name, leading: Avatar(label: u.name, url: u.avatar), onTap: event "profile" {name: u.name}, trailing: IconButton(icon: "delete", tooltip: "移除订阅", onPressed: event "remove" {id: u.id}))]
);
widget AddPerson = PageLayout(children: [TextInput(label: "论坛用户名", hint: "@username", value: data.input, onChanged: event "input" {}, onSubmitted: event "add" {}), Gap(size: 12), Notice(), Button(label: "订阅此人", icon: "add", loading: data.submitting, onPressed: event "add" {})]);
widget BulkImport = PageLayout(children: [Label(text: "从旧名单复制用户名并粘贴到这里，每行一位，也可用空格或逗号分隔。仅加入本插件订阅，不改变网站关注关系。", color: "onSurfaceVariant"), Gap(size: 16), TextInput(label: "用户名名单", value: data.bulk, maxLines: 8, onChanged: event "bulkInput" {}), Gap(size: 12), Notice()], footer: Button(label: "检查并导入", loading: data.submitting, onPressed: event "bulkApply" {}));
widget Following = ListPage(search: SearchInput(hint: "筛选已加载的关注", value: data.query, onChanged: event "query" {}), header: Notice(), loading: data.candidatesLoading, error: data.candidatesError, onRetry: event "candidates" {retry: true}, empty: EmptyState(title: "没有匹配的关注", icon: "group", action: switch data.nextCandidates {true: Button(label: "加载下一页", variant: "text", onPressed: event "candidates" {more: true}), default: SizedBoxShrink()}), onRefresh: event "candidates" {}, hasMore: data.nextCandidates, loadingMore: data.candidatesLoading, onLoadMore: event "candidates" {more: true}, actions: Button(label: data.pickLabel, enabled: data.canPick, loading: data.submitting, onPressed: event "apply" {}), items: [...for u in data.choices: switch u.added {
  true: ListItem(title: u.username, subtitle: "已订阅", leading: Avatar(label: u.username, url: u.avatarUrl), trailing: Symbol(name: "check_circle")),
  default: ListItem(title: u.username, leading: Avatar(label: u.username, url: u.avatarUrl), trailing: switch u.chosen {true: Symbol(name: "check_circle", color: "primary"), default: Symbol(name: "add")}, onTap: event "pick" {name: u.username})
}]);
