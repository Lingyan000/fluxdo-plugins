  switch data.historyWindowEnd {true: Button(label: data.i18n.sb42e32d04aae9a48, variant: "tonal", onPressed: event "historyNext" {}), default: SizedBoxShrink()},
  switch data.progress {"": SizedBoxShrink(), default: Label(text: data.progress, style: "bodySmall", color: "onSurfaceVariant")},
  switch data.error {"": SizedBoxShrink(), default: Label(text: data.error, color: "error")},
  switch data.historyError {"": SizedBoxShrink(), default: ListItem(title: data.historyError, trailing: Button(label: data.i18n.sb8784c8dd5636ff2, variant: "text", onPressed: event "more" {}))},
  switch data.scheduleError {"": SizedBoxShrink(), default: Label(text: data.scheduleError, color: "onSurfaceVariant")}
]);
