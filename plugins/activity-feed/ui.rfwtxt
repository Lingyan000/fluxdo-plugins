widget Following = ListPage(search: SearchInput(hint: data.i18n.s10dde5f6ba4e7531, value: data.query, onChanged: event "query" {}), header: Notice(), loading: data.candidatesLoading, error: data.candidatesError, onRetry: event "candidates" {retry: true}, empty: EmptyState(title: data.i18n.s66fe2bf52b5748b5, icon: "group", action: switch data.nextCandidates {true: Button(label: data.i18n.s7e7af41bb778403b, variant: "text", onPressed: event "candidates" {more: true}), default: SizedBoxShrink()}), onRefresh: event "candidates" {}, hasMore: data.nextCandidates, loadingMore: data.candidatesLoading, onLoadMore: event "candidates" {more: true}, actions: Button(label: data.pickLabel, enabled: data.canPick, loading: data.submitting, onPressed: event "apply" {}), items: [...for u in data.choices: switch u.added {
