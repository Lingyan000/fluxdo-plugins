    {
      "id": "community.fluxdo.activity",
      "name": "动态订阅",
      "version": "1.4.0",
      "apiVersion": 2,
      "author": "FluxDO 社区",
      "summary": "批量更新订阅与历史分页，从关注或旧名单导入，支持四种语言。",
      "description": "按人、类型和未读筛选发帖、回复、赞、回应与 Boost，点击打开原生话题。每人最多缓存最近 200 条，并受总容量约束；历史通过服务器分页，每段显示最多 400 条，可继续较早记录。可独立开启系统后台更新与通知，系统关闭通知时提供设置入口。手机与宽屏使用自适应布局，卡片显示订阅人数和未读统计。预览为模拟数据。",
      "repository": "https://github.com/Lingyan000/fluxdo-plugins",
      "packageUrl": "https://github.com/Lingyan000/fluxdo-plugins/releases/download/activity-feed-1.4.0/activity-feed-1.4.0.fluxplugin",
      "sha256": "d990fdbe5646597dc9e850af1c2e1b3b980cce90d8473b6e0edf5297fb3d399c",
      "icon": "history",
      "categories": [
        "论坛"
      ],
      "screenshots": [
        "https://raw.githubusercontent.com/Lingyan000/fluxdo-plugins/activity-feed-1.2.0/plugins/activity-feed/previews/service-card.png",
        "https://raw.githubusercontent.com/Lingyan000/fluxdo-plugins/activity-feed-1.2.0/plugins/activity-feed/previews/mobile-large.png",
        "https://raw.githubusercontent.com/Lingyan000/fluxdo-plugins/activity-feed-1.2.0/plugins/activity-feed/previews/desktop-dark.png"
      ],
      "changelog": "使用显式账号存储，首次订阅按需申请当前账号和动态权限；拒绝后可再次申请。资料读取合并缓存，关注分页支持取消和迟到结果隔离。增加作者签名，保留原订阅与权限选择。需支持 storageScopes 的宿主。",
      "requiredFeatures": [
        "forumRead",
        "navigationEntries",
        "navigationBadge",
        "scheduledTasks",
        "localNotifications",
        "atomicStorage",
        "runtimePermissions",
        "adaptiveCollections",
        "modalDismiss",
        "cardNavigation",
        "contentPresentation",
        "notificationStatus",
        "hostEnvironment",
        "pageChrome",
        "manifestLocalization",
        "storageScopes"
      ],
      "locales": {
        "en": {
          "name": "Activity feed",
          "summary": "Follow selected members, keep recent activity and see unread updates.",
          "description": "Follow selected members, keep recent activity and see unread updates."
        },
        "zh_TW": {
          "name": "動態訂閱",
          "summary": "按名單聚合論壇動態，保留最近記錄並提醒未讀。",
          "description": "按名單聚合論壇動態，保留最近記錄並提醒未讀。"
        },
        "zh_HK": {
          "name": "動態訂閲",
          "summary": "按名單聚合論壇動態，保留最近記錄並提醒未讀。",
          "description": "按名單聚合論壇動態，保留最近記錄並提醒未讀。"
