  "icon": "history",
  "categories": ["论坛"],
  "screenshots": [
    "https://raw.githubusercontent.com/Lingyan000/fluxdo-plugins/activity-feed-1.1.0/plugins/activity-feed/previews/mobile-large.png",
    "https://raw.githubusercontent.com/Lingyan000/fluxdo-plugins/activity-feed-1.1.0/plugins/activity-feed/previews/desktop-dark.png"
